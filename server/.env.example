DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/url_shortener
PORT=3000

# Required: 32+ random characters. Never use "change-me" in any environment.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Public base used when composing short URLs in responses (optional)
SHORT_BASE=http://localhost:3000

JSON_BODY_LIMIT=32kb
URL_CACHE_MAX=5000
URL_CACHE_TTL_MS=600000

# Optional live reputation
# GOOGLE_SAFE_BROWSING_API_KEY=
# BLOCKED_DOMAINS=evil.test,phish.example

# Optional geo provider override (HTTPS recommended)
# GEO_LOOKUP_URL=https://ipapi.co
